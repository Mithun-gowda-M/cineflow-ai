# ==================================================
# CINEFLOW AI — Environment Configuration Template
# Copy this file to .env and configure as needed.
# ==================================================

# Frontend Configuration
NEXT_PUBLIC_APP_NAME="CINEFLOW AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
PORT=3000

# Backend Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ENVIRONMENT="development"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Hardware and Processing Profile (auto | low | medium | high)
HARDWARE_PROFILE="auto"
MAX_CONCURRENT_RENDERS=2
PROXY_RESOLUTION="720p"

# Storage Directories (Local-First)
UPLOAD_DIR="./data/uploads"
RENDER_DIR="./data/renders"
CACHE_DIR="./data/cache"
PROJECTS_DIR="./data/projects"

# Local AI Engine (Ollama - Free & Open Source)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
EMBEDDING_MODEL="all-minilm"

# Speech & Subtitles (Whisper Local)
WHISPER_MODEL="base"
WHISPER_DEVICE="cpu"

# Media Binaries (Leave blank to use system PATH)
FFMPEG_PATH=""
FFPROBE_PATH=""

# Database (SQLite for local dev, PostgreSQL for campus multi-user)
DATABASE_URL="sqlite:///./data/cineflow.db"

# Institutional Campus Security & Quotas
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=720
USER_STORAGE_QUOTA_GB=25.0
RESTRICT_COLLEGE_EMAIL_DOMAIN=false
ALLOWED_AUTH_DOMAINS="bmsit.in,bmsit.ac.in"
REQUIRE_AUTH_FOR_MEDIA=false
CACHE_TTL_HOURS=24

# Optional External Trend Intelligence (Strictly optional, disabled by default)
ENABLE_YOUTUBE_INTELLIGENCE=false
YOUTUBE_API_KEY=""
ENABLE_INSTAGRAM_INTELLIGENCE=false
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

